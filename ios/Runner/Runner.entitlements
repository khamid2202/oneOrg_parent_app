<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment for push notifications. Not referenced by the Xcode
	     project yet: add it via Runner target > Signing & Capabilities >
	     + Capability > Push Notifications, which also updates the
	     provisioning profile. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
